# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional: custom name used when provisioning the server
COMMUNITY_NAME=[TRADING COMMUNITY NAME]
# Optional: persists signals locally; omit to keep statistics only in memory
SIGNAL_STORE_PATH=./data/signals.json

# Required for screenshot analysis. Never send this key to Discord.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
SHOW_SCREENSHOT_WITH_SIGNAL=false

# OBS → Discord live integration. Enable OBS WebSocket under Tools → WebSocket Server Settings.
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
DISCORD_LIVE_CHANNEL_ID=
DISCORD_LIVE_NOTIFICATION_CHANNEL_ID=
DISCORD_LIVE_ALERT_ROLE_ID=
DISCORD_STREAM_MANAGER_ROLE_ID=
STREAM_DESTINATION_URL=
SEND_STREAM_END_NOTIFICATION=false
LIVE_TEST_MODE=false

# Premium / Stripe (leave blank until Stripe Checkout and a public webhook URL are configured)
PREMIUM_ROLE_ID=
PREMIUM_ROLE_NAME=Premium Member
PREMIUM_DAILY_ANALYSIS_LIMIT=10
PREMIUM_MONTHLY_ANALYSIS_LIMIT=200
AI_ANALYSIS_COOLDOWN_SECONDS=30
MAX_CHART_IMAGE_MB=10
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_WEBHOOK_PORT=8787
PREMIUM_ALLOW_PAST_DUE=false
PREMIUM_SYNC_INTERVAL_MINUTES=60
